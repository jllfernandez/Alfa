<?xml version="1.0" encoding="ISO-8859-1"?>
<Values>
   <Schema>ALEX</Schema>
   
   <Tablas>

	   <Tabla Nombre_Tabla="CAPABILITYES" Seq="y">
		   <Campos>
				<Campo Nombre="ID" Tipo="decimal" Size="(10,0)" Primary="y" Null="n">	
				</Campo>
				
				<Campo Nombre="CODE" Tipo="varchar2" Size="(15)" Index="IDX_CODE_CAPAB"></Campo>
				<Campo Nombre="DESCR" Tipo="varchar2" Size="(35)"></Campo>
				
				
			</Campos>	  
		</Tabla>

	   <Tabla Nombre_Tabla="ROLES" Seq="y">
		   <Campos>
				<Campo Nombre="ID" Tipo="decimal" Size="(10,0)" Primary="y" Null="n">	
				</Campo>
				
				<Campo Nombre="CODE" Tipo="varchar2" Size="(15)" Index="IDX_CODE_ROLE"></Campo>
				<Campo Nombre="DESCR" Tipo="varchar2" Size="(35)"></Campo>
				
				
			</Campos>	  
		</Tabla>


	   <Tabla Nombre_Tabla="CAPABILITYANDROLE" Seq="n">
		   <Campos>
				<Campo Nombre="ID_CAPABILITY" Tipo="decimal" Size="(10,0)" Null="n" FK="ID_CAPABILITYES" Tabla="CAPABILITYES">	
				</Campo>
				<Campo Nombre="ID_ROLE" Tipo="decimal" Size="(10,0)" Null="n" FK="ID_ROLES" Tabla="ROLES">	
				</Campo>
				
				
			</Campos>	  
		</Tabla>



	  <Tabla Nombre_Tabla="COMPONENTES" Seq="y">
		   <Campos>
				<Campo Nombre="ID" Tipo="decimal" Size="(10,0)" Primary="y" Null="n">	
				</Campo>
				
				<Campo Nombre="ID_PIEZA" Tipo="decimal" Size="(10,0)" Null="n" FK="ID" Tabla="PIEZAS">	
				</Campo>
				
				
				<Campo Nombre="CODE" Tipo="varchar2" Size="(15)" Index="INDEX_CODE_COMP"></Campo>
				
				
			</Campos>	  
		</Tabla>
	
	 
		<Tabla Nombre_Tabla="USUARIOS" Seq="y">
		    <Campos>
			   <Campo Nombre="ID" Tipo="decimal" Size="(15,0)" Primary="y" Null="n">	
				</Campo>
				
				<Campo Nombre="ID_ROLE" Tipo="decimal" Size="(10,0)" Null="n" FK="ID" Tabla="ROLES">	
				</Campo>
				<Campo Nombre="LOGIN" Tipo="varchar2" Size="(15)" Index="IDX_USUARIO"></Campo>
				
				<Campo Nombre="PASS" Tipo="varchar2" Size="(15)"> </Campo>
				
				<!--Campo Nombre="FECHA_REGISTRO" Tipo="timestamp"></Campo>
				<Campo Nombre="FECHA_REG" Tipo="date" default="sysdate"></Campo-->
				
				
			</Campos>	
		</Tabla>
</Tablas>

	<Roles>
		<Role name="ROL_SEG_CAL_CON">
		</Role>
		<Role name="ROL_USU_APL_CACCESO">
		</Role>
	</Roles>
   
</Values>